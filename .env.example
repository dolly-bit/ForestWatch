# Copy to .env for local (non-Docker) runs. Never commit real secrets.
DATABASE_URL=sqlite:///./forestwatch.db
REDIS_URL=redis://localhost:6379/0
SYNC_JOBS=1                # 1 = run jobs inline (no Redis needed); 0 = use the Redis/RQ worker
AUTO_CREATE_TABLES=1       # 1 = skip Alembic (dev only); production: run `alembic upgrade head`
CORS_ORIGINS=http://localhost:3000
